{
  "hosting": [
    {
      "target": "dev",
      "public": "dist",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "rewrites": [
        {
          "source": "/api/createComicCheckoutSession",
          "function": "createComicCheckoutSession"
        },
        {
          "source": "/api/stripeComicWebhook",
          "function": "stripeComicWebhook"
        },
        {
          "source": "/api/resendComicAccess",
          "function": "resendComicAccess"
        },
        {
          "source": "/api/verifyLibrarySession",
          "function": "verifyLibrarySession"
        },
        {
          "source": "/api/getLibrary",
          "function": "getLibrary"
        },
        {
          "source": "/api/createAssetAccess",
          "function": "createAssetAccess"
        },
        {
          "source": "**",
          "destination": "/index.html"
        }
      ]
    },
    {
      "target": "prod",
      "public": "dist",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "rewrites": [
        {
          "source": "/api/createComicCheckoutSession",
          "function": "createComicCheckoutSession"
        },
        {
          "source": "/api/stripeComicWebhook",
          "function": "stripeComicWebhook"
        },
        {
          "source": "/api/resendComicAccess",
          "function": "resendComicAccess"
        },
        {
          "source": "/api/verifyLibrarySession",
          "function": "verifyLibrarySession"
        },
        {
          "source": "/api/getLibrary",
          "function": "getLibrary"
        },
        {
          "source": "/api/createAssetAccess",
          "function": "createAssetAccess"
        },
        {
          "source": "**",
          "destination": "/index.html"
        }
      ]
    }
  ],
  "firestore": {
    "rules": "firebase.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "venv",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ],
      "runtime": "nodejs20"
    }
  ]
}
