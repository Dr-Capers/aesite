rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /launchSignups/{document} {
      // Launch-list writes are server-only. Public clients must never be able
      // to create subscriber records or trigger email from Firestore directly.
      allow read, write: if false;
    }

    match /pendingLaunchSignups/{document} {
      allow read, write: if false;
    }

    match /signupRateLimits/{document} {
      allow read, write: if false;
    }
  }
}
